{
  "name": "duo-frame",
  "version": "0.0.0",
  "private": true,
  "description": "A React device frame for iPhone Duo previews.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "pnpm build && pnpm --filter @duo-frame/demo-react19 dev",
    "dev:react16": "pnpm build && pnpm --filter @duo-frame/demo-react16 dev",
    "dev:react19": "pnpm build && pnpm --filter @duo-frame/demo-react19 dev",
    "test": "vp test",
    "check": "vp check && pnpm -r --filter \"@duo-frame/demo-*\" check",
    "build:demos": "pnpm build && pnpm -r --filter \"@duo-frame/demo-*\" build",
    "watch": "vp pack --watch"
  },
  "dependencies": {
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.21.0"
}
