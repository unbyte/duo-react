{
  "name": "duo-react-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm build && pnpm check:lint && pnpm check:types",
    "check:lint": "biome check",
    "check:types": "tsc -b",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "cov": "vitest run --coverage",
    "build:playground": "turbo run build --filter=@private/playground",
    "preview:playground": "pnpm --filter @private/playground preview",
    "deploy:playground": "pnpm --filter @private/playground run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.21.0"
}
