{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      // The linked library has React 16 development types.
      // Check its declarations with the playground's React 19 types.
      // Published consumers resolve their own React types without this mapping.
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
