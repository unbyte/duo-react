{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              {
                "name": "useBrowserLayoutEffect",
                "closureIndex": 0,
                "dependenciesIndex": 1
              }
            ],
            "reportUnnecessaryDependencies": false
          }
        },
        "useHookAtTopLevel": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/duo-react/**"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    },
    {
      "includes": [
        "packages/duo-react/src/components/system/**",
        "packages/playground/public/favicon.svg",
        "packages/playground/src/preview/draggable-block.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/duo-react/src/components/system/system.tsx",
        "packages/duo-react/src/components/tab-bar/glass-tabs.tsx",
        "packages/playground/src/preview/draggable-block.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/duo-react/src/components/region-mask/region-mask.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/duo-react/src/components/tab-bar/renderer.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/playground/src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
