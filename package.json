{
  "name": "duo-react-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run duo-react#build",
    "dev": "vp run build && vp run @duo-frame/playground#dev",
    "test": "vp test",
    "check": "vp run build && vp check && vp run @duo-frame/playground#check:types",
    "watch": "vp run duo-react#watch",
    "build:playground": "vp run build && vp run @duo-frame/playground#build",
    "preview:playground": "vp run @duo-frame/playground#preview",
    "deploy:playground": "vp run build:playground && vp run @duo-frame/playground#deploy"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.21.0"
}
