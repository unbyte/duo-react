{
  "name": "duo-react",
  "version": "0.1.0",
  "description": "React components for previewing web apps in iPhone Duo device layouts.",
  "keywords": [
    "iphone-duo",
    "iphone",
    "ios",
    "react",
    "component",
    "react-components",
    "device-frame",
    "device-preview",
    "responsive-design",
    "foldable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbyte/duo-react.git",
    "directory": "packages/duo-react"
  },
  "homepage": "https://github.com/unbyte/duo-react#readme",
  "bugs": {
    "url": "https://github.com/unbyte/duo-react/issues"
  },
  "files": [
    "lib",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "turbo run build"
  },
  "dependencies": {
    "@zumer/snapdom": "^3.2.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@private/browser": "workspace:*",
    "@private/core": "workspace:*",
    "@private/profiles": "workspace:*",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "@types/use-sync-external-store": "^1.5.0",
    "react": "16.8.6",
    "react-dom": "16.8.6"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "main": "lib/index.cjs",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./lib/index.d.ts",
          "default": "./lib/index.js"
        },
        "require": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
      },
      "./package.json": "./package.json",
      "./style.css": "./lib/index.css"
    }
  }
}
